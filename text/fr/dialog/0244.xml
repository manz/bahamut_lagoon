    <text>
        <refs>
            <ref>0xdd</ref>
        </refs>
        <data>Sendak: Reine Yoyo ! Que se passe-t-il ?![end]</data>
    </text>
    <text>
        <refs>
            <ref>0xf2</ref>
        </refs>
        <data>Yoyo: Hihi... Tu exagères. Ce n'est rien... J'ai juste eu un petit frisson.[end]</data>
