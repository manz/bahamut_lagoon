<?xml version="1.0" standalone="yes"?>
<texts base="0x83a" room_id="70">
    <text>
        <refs>
            <ref>0xda</ref>
        </refs>
        <data>  -Empire de Granbelos-[end1]</data>
    </text>
    <text>
        <refs>
            <ref>0xf0</ref>
        </refs>
        <data>  Le génie de la guerre,
  l'empereur Sauzer,[end1]</data>
    </text>
    <text>
        <refs>
            <ref>0x125</ref>
        </refs>
        <data>  tourna son ambition et ses rêves
  vers la conquête des cieux...[end1]</data>
    </text>
    <text>
        <refs>
            <ref>0x13b</ref>
        </refs>
        <data>  Et ainsi...
  la guerre éclata.[end1]</data>
    </text>
    <text>
        <refs>
            <ref>0x3ed</ref>
        </refs>
        <data>  Le feu de la guerre embrasa le ciel...
  et d'innombrables lagons
  tombèrent aux mains de l'Empire.[end1]</data>
    </text>
    <text>
        <refs>
            <ref>0x763</ref>
        </refs>
        <data>  Le ciel...
  se teinta des couleurs du chagrin.[end1]</data>
    </text>
</texts>